<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@drawable/iconchess"
        android:label="@string/app_name"
        android:roundIcon="@drawable/iconchess"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChessAndroid">
        <activity
            android:name=".MainActivity2"
            android:exported="false"
            android:label="@string/title_activity_main2" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.ChessAndroid.NoActionBar" />
        <activity
            android:name=".View.MenuActivity"
            android:exported="false"
            android:label="@string/title_activity_main_menu"
            android:theme="@style/Theme.ChessAndroid.NoActionBar" />
        <activity
            android:name=".View.SighUpActivity"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:exported="false"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@drawable/iconchess" />
        <activity
            android:name=".View.AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".View.GameActivity"
            android:exported="true" />
    </application>

</manifest>